# ---- Database (required) ----
# Free MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/honeychain

# ---- Blockchain (optional to start — app runs fine without these) ----
# Free RPC endpoint from https://www.alchemy.com or https://www.infura.io (choose "Polygon Amoy")
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Private key of a TEST-ONLY wallet (never your real wallet). Fund it free at
# https://faucet.polygon.technology (select Amoy)
PRIVATE_KEY=your_test_wallet_private_key

# Address you get after deploying contracts/HoneyChain.sol (see README)
CONTRACT_ADDRESS=0xYourDeployedContractAddress
